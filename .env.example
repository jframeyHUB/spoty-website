# Supabase (Project Settings -> API). The URL and publishable/anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (waitlist + transactional email). Never commit real values.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
